generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth & users
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  countryCode  String   @default("+227") // Niger
  name         String?
  username     String?  @unique
  avatarUrl    String?
  language     String   @default("fr")
  role         String   @default("user") // user | driver | admin
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations ConversationUser[]
  messages      Message[]
  ads           Ad[]
  rides         Ride[]
  rideRequests  RideRequest[]
  wallets       Wallet[]
  transactions  Transaction[]
  deviceTokens  DeviceToken[]
}

model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  code      String
  purpose   String    @default("login") // login | verify
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, code])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  platform  String   @default("web") // web | android | ios
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
}

// ---------------------------------------------------------------------------
// Messaging (offline-first)
// ---------------------------------------------------------------------------

model Conversation {
  id         String             @id @default(cuid())
  type       String             @default("direct") // direct | group
  title      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  lastMessageId String?

  users      ConversationUser[]
  messages   Message[]
}

model ConversationUser {
  conversationId String
  userId         String
  role           String   @default("member")
  lastReadAt     DateTime?
  muted          Boolean  @default(false)
  joinedAt       DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  clientMsgId    String?      // idempotency: stable id generated by the client
  type           String       @default("text") // text | image | location | audio | system
  body           String?
  mediaUrl       String?
  mediaMeta      String?      // JSON: size, width, height, duration
  replyToId      String?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientMsgId])
  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Petites annonces
// ---------------------------------------------------------------------------

model Ad {
  id          String   @id @default(cuid())
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category    String   // vehicules | immobilier | electronique | emploi | agriculture | autre
  title       String
  description String
  price       Int?
  currency    String   @default("XOF")
  city        String?
  images      String   @default("[]") // JSON array of URLs
  status      String   @default("active") // active | sold | archived
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, status])
}

// ---------------------------------------------------------------------------
// Transport
// ---------------------------------------------------------------------------

model Ride {
  id           String        @id @default(cuid())
  driverId     String
  driver       User          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  from         String
  to           String
  departAt     DateTime
  pricePerSeat Int
  seatsTotal   Int           @default(3)
  seatsLeft    Int           @default(3)
  vehicle      String?
  status       String        @default("scheduled") // scheduled | inProgress | completed | cancelled
  createdAt    DateTime      @default(now())

  requests     RideRequest[]
  @@index([from, to, departAt])
}

model RideRequest {
  id        String   @id @default(cuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seats     Int      @default(1)
  status    String   @default("pending") // pending | accepted | declined | cancelled
  createdAt DateTime @default(now())

  @@unique([rideId, userId])
}

// ---------------------------------------------------------------------------
// Paiement / Mobile money
// ---------------------------------------------------------------------------

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0) // in smallest unit (XOF has no cents => XOF)
  currency  String   @default("XOF")
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@unique([userId])
}

model Transaction {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // credit | debit
  amount    Int
  method    String   // mobile_money | wallet | ussd
  provider  String?  // orange | moov | airtel
  reference String?  // external mobile money reference
  meta      String?  // JSON
  status    String   @default("pending") // pending | success | failed
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Actualités locales
// ---------------------------------------------------------------------------

model NewsItem {
  id        String   @id @default(cuid())
  category  String   @default("general") // general | niger | afrique | sport | tech | economie
  title     String
  summary   String?
  body      String?
  imageUrl  String?
  source    String?
  lang      String   @default("fr")
  publishedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([category, publishedAt])
}
